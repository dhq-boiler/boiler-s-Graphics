<UserControl
    x:Class="boilersGraphics.Views.Animation.PngSequenceExportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="320"
    d:DesignWidth="500"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource ControlDarkerBackground}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/boilersGraphics;component/Resources/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/boilersGraphics;component/Resources/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <prism:Dialog.WindowStyle>
        <Style TargetType="{x:Type Window}">
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="Topmost" Value="True" />
        </Style>
    </prism:Dialog.WindowStyle>
    <DockPanel Margin="10" MinWidth="460">
        <StackPanel
            HorizontalAlignment="Right"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="ExecuteButton"
                AutomationProperties.AutomationId="PngSeqExecute"
                Width="120"
                Height="28"
                Margin="5"
                Command="{Binding ExecuteCommand}"
                Content="書き出し" />
            <Button
                x:Name="CancelButton"
                AutomationProperties.AutomationId="PngSeqCancel"
                Width="100"
                Height="28"
                Margin="5"
                Command="{Binding CancelCommand}"
                Content="キャンセル" />
        </StackPanel>
        <StackPanel Orientation="Vertical">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="開始時刻 (s)" VerticalAlignment="Center" />
                <TextBox
                    Grid.Column="1"
                    AutomationProperties.AutomationId="PngSeqStart"
                    MinHeight="26"
                    Text="{Binding Start.Value, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" />
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="終了時刻 (s)" VerticalAlignment="Center" />
                <TextBox
                    Grid.Column="1"
                    AutomationProperties.AutomationId="PngSeqEnd"
                    MinHeight="26"
                    Text="{Binding End.Value, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" />
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Fps" VerticalAlignment="Center" />
                <TextBox
                    Grid.Column="1"
                    AutomationProperties.AutomationId="PngSeqFps"
                    MinHeight="26"
                    Text="{Binding Fps.Value, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <Grid Margin="0,6,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="出力フォルダ" VerticalAlignment="Center" />
                <TextBox
                    Grid.Column="1"
                    AutomationProperties.AutomationId="PngSeqOutputDir"
                    MinHeight="26"
                    Text="{Binding OutputDirectory.Value, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="2"
                    AutomationProperties.AutomationId="PngSeqBrowse"
                    Margin="6,0,0,0"
                    MinHeight="26"
                    Command="{Binding BrowseCommand}"
                    Content="参照..." />
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="ファイル名 prefix" VerticalAlignment="Center" />
                <TextBox
                    Grid.Column="1"
                    AutomationProperties.AutomationId="PngSeqPrefix"
                    MinHeight="26"
                    Text="{Binding FilenamePrefix.Value, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Foreground="{StaticResource ControlDefaultForeground}">
                    <Run Text="書き出しフレーム数:" />
                    <Run Text="{Binding FrameCount.Value, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
                <TextBlock
                    Margin="20,0,0,0"
                    Foreground="#FFFF6666"
                    Text="{Binding ValidationMessage.Value}" />
            </StackPanel>

            <TextBlock
                Margin="0,10,0,0"
                FontSize="11"
                Foreground="{StaticResource ControlDefaultForeground}"
                TextWrapping="Wrap"
                Text="Phase 5-f: Start〜End を Fps 間隔でサンプリングして PNG を連番出力するっす。両端含む (例: 0〜2s @ 30fps なら 61 枚)。出力ファイル名は prefix + 0 詰め番号 + .png (最小 4 桁)。" />
        </StackPanel>
    </DockPanel>
</UserControl>
