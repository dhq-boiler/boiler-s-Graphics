<UserControl
    x:Class="boilersGraphics.Views.Animation.WpfXamlExportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="380"
    d:DesignWidth="520"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource ControlDarkerBackground}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/boilersGraphics;component/Resources/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/boilersGraphics;component/Resources/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <prism:Dialog.WindowStyle>
        <Style TargetType="{x:Type Window}">
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="Topmost" Value="True" />
        </Style>
    </prism:Dialog.WindowStyle>
    <DockPanel Margin="10" MinWidth="480">
        <StackPanel
            HorizontalAlignment="Right"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="ExecuteButton"
                AutomationProperties.AutomationId="WpfXamlExecute"
                Width="120"
                Height="28"
                Margin="5"
                Command="{Binding ExecuteCommand}"
                Content="書き出し" />
            <Button
                x:Name="CancelButton"
                AutomationProperties.AutomationId="WpfXamlCancel"
                Width="100"
                Height="28"
                Margin="5"
                Command="{Binding CancelCommand}"
                Content="キャンセル" />
        </StackPanel>
        <StackPanel Orientation="Vertical">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="ターゲット名前空間" VerticalAlignment="Center" />
                <TextBox
                    Grid.Column="1"
                    AutomationProperties.AutomationId="WpfXamlNamespace"
                    MinHeight="26"
                    Text="{Binding TargetNamespace.Value, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="クラス名" VerticalAlignment="Center" />
                <TextBox
                    Grid.Column="1"
                    AutomationProperties.AutomationId="WpfXamlClassName"
                    MinHeight="26"
                    Text="{Binding ClassName.Value, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="アクセス修飾子" VerticalAlignment="Center" />
                <ComboBox
                    Grid.Column="1"
                    AutomationProperties.AutomationId="WpfXamlAccessModifier"
                    MinHeight="26"
                    ItemsSource="{Binding AccessModifierChoices}"
                    SelectedItem="{Binding AccessModifier.Value}" />
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="インデント幅" VerticalAlignment="Center" />
                <TextBox
                    Grid.Column="1"
                    AutomationProperties.AutomationId="WpfXamlIndent"
                    MinHeight="26"
                    Text="{Binding IndentWidth.Value, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox
                    Grid.Column="2"
                    AutomationProperties.AutomationId="WpfXamlGenerateCodeBehind"
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    Content=".xaml.cs を生成"
                    IsChecked="{Binding GenerateCodeBehind.Value}" />
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="ヘッダコメント" VerticalAlignment="Center" />
                <CheckBox
                    Grid.Column="1"
                    AutomationProperties.AutomationId="WpfXamlIncludeHeader"
                    VerticalAlignment="Center"
                    Content="Generated by ... コメントを入れる"
                    IsChecked="{Binding IncludeHeaderComment.Value}" />
            </Grid>
            <Grid Margin="0,6,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="出力ファイル" VerticalAlignment="Center" />
                <TextBox
                    Grid.Column="1"
                    AutomationProperties.AutomationId="WpfXamlOutputPath"
                    MinHeight="26"
                    Text="{Binding OutputPath.Value, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="2"
                    AutomationProperties.AutomationId="WpfXamlBrowse"
                    Margin="6,0,0,0"
                    MinHeight="26"
                    Command="{Binding BrowseCommand}"
                    Content="参照..." />
            </Grid>

            <TextBlock
                Margin="0,8,0,0"
                Foreground="#FFFF6666"
                Text="{Binding ValidationMessage.Value}" />

            <TextBlock
                Margin="0,10,0,0"
                FontSize="11"
                Foreground="{StaticResource ControlDefaultForeground}"
                TextWrapping="Wrap"
                Text="Phase 5.5: 現在の Timeline + 図形を WPF UserControl + Storyboard の XAML として出力するっす。.xaml.cs を生成するチェックを入れると、BeginAnimation() / StopAnimation() を含む partial class も同名 (.xaml.cs) で書き出すっす。" />
        </StackPanel>
    </DockPanel>
</UserControl>
