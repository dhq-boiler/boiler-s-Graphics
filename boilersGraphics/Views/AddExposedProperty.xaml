<UserControl
    x:Class="boilersGraphics.Views.AddExposedProperty"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="280"
    d:DesignWidth="400"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="MinWidth" Value="400" />
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/boilersGraphics;component/Resources/Theme.xaml" />
                <ResourceDictionary
                    Source="pack://application:,,,/boilersGraphics;component/Resources/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="16" Width="360">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,4"
            Text="名前" />
        <TextBox
            x:Name="NameTextBox"
            Grid.Row="1"
            Margin="0,0,0,8"
            AutomationProperties.AutomationId="ExposedPropertyNameTextBox"
            Text="{Binding Name.Value, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock
            Grid.Row="2"
            Margin="0,0,0,4"
            Text="型" />
        <ComboBox
            Grid.Row="3"
            Margin="0,0,0,8"
            AutomationProperties.AutomationId="ExposedPropertyTypeComboBox"
            ItemsSource="{Binding AvailableTypes}"
            SelectedItem="{Binding SelectedType.Value}" />

        <TextBlock
            Grid.Row="4"
            Margin="0,0,0,4"
            Text="デフォルト値 (任意)" />
        <TextBox
            Grid.Row="5"
            Margin="0,0,0,8"
            AutomationProperties.AutomationId="ExposedPropertyDefaultValueTextBox"
            Text="{Binding DefaultValueText.Value, UpdateSourceTrigger=PropertyChanged}" />

        <CheckBox
            Grid.Row="6"
            Margin="0,0,0,8"
            AutomationProperties.AutomationId="ExposedPropertyIsArrayCheckBox"
            Content="配列として扱う (Phase 1-a Q-2b)"
            IsChecked="{Binding IsArray.Value}" />

        <TextBlock
            Grid.Row="7"
            Margin="0,0,0,8"
            FontSize="11"
            Foreground="#FF7676"
            Text="{Binding ErrorMessage.Value}" />

        <StackPanel
            Grid.Row="11"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,8,0"
                AutomationProperties.AutomationId="AddExposedPropertyOkButton"
                Command="{Binding OkCommand}"
                Content="OK"
                IsDefault="True" />
            <Button
                Width="80"
                Command="{Binding CancelCommand}"
                Content="キャンセル"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</UserControl>
