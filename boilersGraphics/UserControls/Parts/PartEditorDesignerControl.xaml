<UserControl
    x:Class="boilersGraphics.UserControls.Parts.PartEditorDesignerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:boilersGraphics.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Focusable="True"
    PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
    PreviewMouseMove="OnPreviewMouseMove"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
        <converters:DoubleToStringConverter x:Key="DoubleToString" />
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
    </UserControl.InputBindings>
    <DockPanel LastChildFill="True">
        <!--  Editing toolbar (Phase 1-c-6-d-2: Rectangle 追加 + 削除)  -->
        <Border
            Padding="6,4"
            Background="#252526"
            BorderBrush="#3F3F46"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <Button
                    Padding="10,4"
                    Command="{Binding AddRectangleCommand}"
                    Content="矩形を追加"
                    ToolTip="新しい矩形を編集中のパーツに追加します" />
                <Button
                    Margin="6,0,0,0"
                    Padding="10,4"
                    Command="{Binding DeleteSelectedCommand}"
                    Content="選択を削除"
                    ToolTip="選択中の図形を削除します (Delete キー可)" />
            </StackPanel>
        </Border>

        <!--
            Property panel (Phase 1-c-6-d-4): SelectedItem の Left/Top/Width/Height/EdgeThickness を編集する。
            SelectedItem.Value が null のときは Collapsed。色は現状表示のみ (編集は別 Phase で対応)。
        -->
        <Border
            Width="220"
            Background="#252526"
            BorderBrush="#3F3F46"
            BorderThickness="1,0,0,0"
            DockPanel.Dock="Right"
            Visibility="{Binding SelectedItem.Value, Converter={StaticResource NullToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10" DataContext="{Binding SelectedItem.Value}">
                    <TextBlock
                        Margin="0,0,0,8"
                        FontWeight="Bold"
                        Foreground="#DDDDDD"
                        Text="プロパティ" />

                    <TextBlock
                        Margin="0,4,0,2"
                        FontSize="11"
                        Foreground="#AAAAAA"
                        Text="位置" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="#DDDDDD"
                            Text="Left" />
                        <TextBox
                            x:Name="LeftTextBox"
                            Grid.Column="1"
                            Padding="4,2"
                            AutomationProperties.AutomationId="LeftTextBox"
                            Text="{Binding Left.Value, Converter={StaticResource DoubleToString}, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="#DDDDDD"
                            Text="Top" />
                        <TextBox
                            x:Name="TopTextBox"
                            Grid.Column="1"
                            Padding="4,2"
                            AutomationProperties.AutomationId="TopTextBox"
                            Text="{Binding Top.Value, Converter={StaticResource DoubleToString}, UpdateSourceTrigger=LostFocus}" />
                    </Grid>

                    <TextBlock
                        Margin="0,4,0,2"
                        FontSize="11"
                        Foreground="#AAAAAA"
                        Text="サイズ" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="#DDDDDD"
                            Text="Width" />
                        <TextBox
                            x:Name="WidthTextBox"
                            Grid.Column="1"
                            Padding="4,2"
                            AutomationProperties.AutomationId="WidthTextBox"
                            Text="{Binding Width.Value, Converter={StaticResource DoubleToString}, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="#DDDDDD"
                            Text="Height" />
                        <TextBox
                            x:Name="HeightTextBox"
                            Grid.Column="1"
                            Padding="4,2"
                            AutomationProperties.AutomationId="HeightTextBox"
                            Text="{Binding Height.Value, Converter={StaticResource DoubleToString}, UpdateSourceTrigger=LostFocus}" />
                    </Grid>

                    <TextBlock
                        Margin="0,4,0,2"
                        FontSize="11"
                        Foreground="#AAAAAA"
                        Text="枠線" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="#DDDDDD"
                            Text="太さ" />
                        <TextBox
                            x:Name="EdgeThicknessTextBox"
                            Grid.Column="1"
                            Padding="4,2"
                            AutomationProperties.AutomationId="EdgeThicknessTextBox"
                            Text="{Binding EdgeThickness.Value, Converter={StaticResource DoubleToString}, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="#DDDDDD"
                            Text="色" />
                        <Border
                            Grid.Column="1"
                            Height="20"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            Background="{Binding EdgeBrush.Value}"
                            ToolTip="枠線の色 (編集は次フェーズで対応)" />
                    </Grid>

                    <TextBlock
                        Margin="0,4,0,2"
                        FontSize="11"
                        Foreground="#AAAAAA"
                        Text="塗りつぶし" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="#DDDDDD"
                            Text="色" />
                        <Border
                            Grid.Column="1"
                            Height="20"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            Background="{Binding FillBrush.Value}"
                            ToolTip="塗りつぶしの色 (編集は次フェーズで対応)" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  Editing canvas: shows PartDefinition.Items  -->
        <Grid Background="#1E1E1E">
            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsRoot" ItemsSource="{Binding Definition.Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas
                                MinWidth="400"
                                MinHeight="300"
                                Background="Transparent" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <!--
                            Border (Background=Transparent) で包んで hit-test を確保する。
                            内側の ContentPresenter は DataType マッチで既存の
                            <NRectangleViewModel> 用 DataTemplate (App.xaml) を使う。
                        -->
                        <DataTemplate>
                            <Border Background="Transparent">
                                <ContentPresenter Content="{Binding}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnItemPreviewMouseLeftButtonDown" />
                            <Setter Property="Canvas.Left" Value="{Binding Left.Value}" />
                            <Setter Property="Canvas.Top" Value="{Binding Top.Value}" />
                            <Setter Property="Panel.ZIndex" Value="{Binding ZIndex.Value}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected.Value}" Value="True">
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect
                                                BlurRadius="6"
                                                Color="#1E90FF"
                                                ShadowDepth="0" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
