<UserControl
    x:Class="boilersGraphics.UserControls.Parts.PartEditorDesignerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:boilersGraphics.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Focusable="True"
    PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
    PreviewMouseMove="OnPreviewMouseMove"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
        <converters:DoubleToStringConverter x:Key="DoubleToString" />
        <!--
            Phase 1 フォローアップ A: プロパティ行右端のピンアイコン用スタイル。
            親 UserControl 側で対応する IsXxxExposed RP を bind する。
            DataTrigger は派生スタイル側で書くため、ここでは見た目のベースだけ持つ。
        -->
        <Style x:Key="ExposurePinButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
    </UserControl.InputBindings>
    <DockPanel LastChildFill="True">
        <!--  Editing toolbar (Phase 1-c-6-d-2: Rectangle 追加 + 削除)  -->
        <Border
            Padding="6,4"
            Background="#252526"
            BorderBrush="#3F3F46"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <Button
                    Padding="10,4"
                    Command="{Binding AddRectangleCommand}"
                    Content="矩形を追加"
                    ToolTip="新しい矩形を編集中のパーツに追加します" />
                <Button
                    Margin="6,0,0,0"
                    Padding="10,4"
                    Command="{Binding DeleteSelectedCommand}"
                    Content="選択を削除"
                    ToolTip="選択中の図形を削除します (Delete キー可)" />
            </StackPanel>
        </Border>

        <!--
            Property panel (Phase 1-c-6-d-4 / d-6): SelectedItem の Left/Top/Width/Height/EdgeThickness を編集する。
            SelectedItem.Value が null のときはプロパティセクションのみ Collapsed (公開パラメータセクションは常時表示)。
        -->
        <Border
            Width="240"
            Background="#252526"
            BorderBrush="#3F3F46"
            BorderThickness="1,0,0,0"
            DockPanel.Dock="Right">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <StackPanel
                        DataContext="{Binding SelectedItem.Value}"
                        Visibility="{Binding DataContext.SelectedItem.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource NullToVisibility}}">
                    <TextBlock
                        Margin="0,0,0,8"
                        FontWeight="Bold"
                        Foreground="#DDDDDD"
                        Text="プロパティ" />

                    <TextBlock
                        Margin="0,4,0,2"
                        FontSize="11"
                        Foreground="#AAAAAA"
                        Text="位置" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="26" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="#DDDDDD"
                            Text="Left" />
                        <TextBox
                            x:Name="LeftTextBox"
                            Grid.Column="1"
                            Padding="4,2"
                            AutomationProperties.AutomationId="LeftTextBox"
                            Text="{Binding Left.Value, Converter={StaticResource DoubleToString}, UpdateSourceTrigger=LostFocus}" />
                        <Button
                            Grid.Column="2"
                            Margin="4,0,0,0"
                            AutomationProperties.AutomationId="LeftExposurePin"
                            Command="{Binding DataContext.TogglePropertyExposureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="Left"
                            Style="{StaticResource ExposurePinButtonStyle}"
                            ToolTip="このプロパティを公開する">
                            <TextBlock FontSize="11" Text="●">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#666666" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsLeftExposed.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                <Setter Property="Foreground" Value="#1E90FF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="26" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="#DDDDDD"
                            Text="Top" />
                        <TextBox
                            x:Name="TopTextBox"
                            Grid.Column="1"
                            Padding="4,2"
                            AutomationProperties.AutomationId="TopTextBox"
                            Text="{Binding Top.Value, Converter={StaticResource DoubleToString}, UpdateSourceTrigger=LostFocus}" />
                        <Button
                            Grid.Column="2"
                            Margin="4,0,0,0"
                            AutomationProperties.AutomationId="TopExposurePin"
                            Command="{Binding DataContext.TogglePropertyExposureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="Top"
                            Style="{StaticResource ExposurePinButtonStyle}"
                            ToolTip="このプロパティを公開する">
                            <TextBlock FontSize="11" Text="●">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#666666" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsTopExposed.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                <Setter Property="Foreground" Value="#1E90FF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <TextBlock
                        Margin="0,4,0,2"
                        FontSize="11"
                        Foreground="#AAAAAA"
                        Text="サイズ" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="26" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="#DDDDDD"
                            Text="Width" />
                        <TextBox
                            x:Name="WidthTextBox"
                            Grid.Column="1"
                            Padding="4,2"
                            AutomationProperties.AutomationId="WidthTextBox"
                            Text="{Binding Width.Value, Converter={StaticResource DoubleToString}, UpdateSourceTrigger=LostFocus}" />
                        <Button
                            Grid.Column="2"
                            Margin="4,0,0,0"
                            AutomationProperties.AutomationId="WidthExposurePin"
                            Command="{Binding DataContext.TogglePropertyExposureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="Width"
                            Style="{StaticResource ExposurePinButtonStyle}"
                            ToolTip="このプロパティを公開する">
                            <TextBlock FontSize="11" Text="●">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#666666" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsWidthExposed.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                <Setter Property="Foreground" Value="#1E90FF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="26" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="#DDDDDD"
                            Text="Height" />
                        <TextBox
                            x:Name="HeightTextBox"
                            Grid.Column="1"
                            Padding="4,2"
                            AutomationProperties.AutomationId="HeightTextBox"
                            Text="{Binding Height.Value, Converter={StaticResource DoubleToString}, UpdateSourceTrigger=LostFocus}" />
                        <Button
                            Grid.Column="2"
                            Margin="4,0,0,0"
                            AutomationProperties.AutomationId="HeightExposurePin"
                            Command="{Binding DataContext.TogglePropertyExposureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="Height"
                            Style="{StaticResource ExposurePinButtonStyle}"
                            ToolTip="このプロパティを公開する">
                            <TextBlock FontSize="11" Text="●">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#666666" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsHeightExposed.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                <Setter Property="Foreground" Value="#1E90FF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <TextBlock
                        Margin="0,4,0,2"
                        FontSize="11"
                        Foreground="#AAAAAA"
                        Text="枠線" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="26" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="#DDDDDD"
                            Text="太さ" />
                        <TextBox
                            x:Name="EdgeThicknessTextBox"
                            Grid.Column="1"
                            Padding="4,2"
                            AutomationProperties.AutomationId="EdgeThicknessTextBox"
                            Text="{Binding EdgeThickness.Value, Converter={StaticResource DoubleToString}, UpdateSourceTrigger=LostFocus}" />
                        <Button
                            Grid.Column="2"
                            Margin="4,0,0,0"
                            AutomationProperties.AutomationId="EdgeThicknessExposurePin"
                            Command="{Binding DataContext.TogglePropertyExposureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="EdgeThickness"
                            Style="{StaticResource ExposurePinButtonStyle}"
                            ToolTip="このプロパティを公開する">
                            <TextBlock FontSize="11" Text="●">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#666666" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsEdgeThicknessExposed.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                <Setter Property="Foreground" Value="#1E90FF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="26" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="#DDDDDD"
                            Text="色" />
                        <Button
                            Grid.Column="1"
                            Height="22"
                            Padding="1"
                            AutomationProperties.AutomationId="EdgeColorButton"
                            Background="Transparent"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            Command="{Binding DataContext.SelectEdgeColorCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Cursor="Hand"
                            ToolTip="クリックで枠線の色を編集">
                            <Border Background="{Binding EdgeBrush.Value}" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            Margin="4,0,0,0"
                            AutomationProperties.AutomationId="EdgeBrushExposurePin"
                            Command="{Binding DataContext.TogglePropertyExposureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="EdgeBrush"
                            Style="{StaticResource ExposurePinButtonStyle}"
                            ToolTip="このプロパティを公開する">
                            <TextBlock FontSize="11" Text="●">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#666666" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsEdgeBrushExposed.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                <Setter Property="Foreground" Value="#1E90FF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <TextBlock
                        Margin="0,4,0,2"
                        FontSize="11"
                        Foreground="#AAAAAA"
                        Text="塗りつぶし" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="26" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="#DDDDDD"
                            Text="色" />
                        <Button
                            Grid.Column="1"
                            Height="22"
                            Padding="1"
                            AutomationProperties.AutomationId="FillColorButton"
                            Background="Transparent"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            Command="{Binding DataContext.SelectFillColorCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Cursor="Hand"
                            ToolTip="クリックで塗りつぶしの色を編集">
                            <Border Background="{Binding FillBrush.Value}" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            Margin="4,0,0,0"
                            AutomationProperties.AutomationId="FillBrushExposurePin"
                            Command="{Binding DataContext.TogglePropertyExposureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="FillBrush"
                            Style="{StaticResource ExposurePinButtonStyle}"
                            ToolTip="このプロパティを公開する">
                            <TextBlock FontSize="11" Text="●">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#666666" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsFillBrushExposed.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                <Setter Property="Foreground" Value="#1E90FF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                    </StackPanel>

                    <!--
                        Phase 3-h §5.7 / Q-9: Phase 3 で追加された公開可能プロパティ。
                        OrthogonalConnector / AnchorBezierConnector / Anchor / IsNode 系。
                        該当プロパティを持たない型に対してはトグルが no-op (PartEditorViewModel 側でガード)。
                        値編集は inline では行わず、ピン留めの可否のみを操作する。
                    -->
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontWeight="Bold"
                            Foreground="#DDDDDD"
                            Text="Phase 3 公開可能プロパティ" />
                        <ItemsControl AutomationProperties.AutomationId="Phase3ExposurePinList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#DDDDDD" Text="BeginPoint" />
                            <Button Grid.Column="1" Margin="4,0,0,0"
                                    AutomationProperties.AutomationId="BeginPointExposurePin"
                                    Command="{Binding DataContext.TogglePropertyExposureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="BeginPoint"
                                    Style="{StaticResource ExposurePinButtonStyle}"
                                    ToolTip="このプロパティを公開する">
                                <TextBlock FontSize="11" Text="●">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#666666" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsBeginPointExposed.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                    <Setter Property="Foreground" Value="#1E90FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#DDDDDD" Text="EndPoint" />
                            <Button Grid.Column="1" Margin="4,0,0,0"
                                    AutomationProperties.AutomationId="EndPointExposurePin"
                                    Command="{Binding DataContext.TogglePropertyExposureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="EndPoint"
                                    Style="{StaticResource ExposurePinButtonStyle}"
                                    ToolTip="このプロパティを公開する">
                                <TextBlock FontSize="11" Text="●">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#666666" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsEndPointExposed.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                    <Setter Property="Foreground" Value="#1E90FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#DDDDDD" Text="BeginControlPoint" />
                            <Button Grid.Column="1" Margin="4,0,0,0"
                                    AutomationProperties.AutomationId="BeginControlPointExposurePin"
                                    Command="{Binding DataContext.TogglePropertyExposureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="BeginControlPoint"
                                    Style="{StaticResource ExposurePinButtonStyle}"
                                    ToolTip="このプロパティを公開する">
                                <TextBlock FontSize="11" Text="●">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#666666" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsBeginControlPointExposed.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                    <Setter Property="Foreground" Value="#1E90FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#DDDDDD" Text="EndControlPoint" />
                            <Button Grid.Column="1" Margin="4,0,0,0"
                                    AutomationProperties.AutomationId="EndControlPointExposurePin"
                                    Command="{Binding DataContext.TogglePropertyExposureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="EndControlPoint"
                                    Style="{StaticResource ExposurePinButtonStyle}"
                                    ToolTip="このプロパティを公開する">
                                <TextBlock FontSize="11" Text="●">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#666666" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsEndControlPointExposed.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                    <Setter Property="Foreground" Value="#1E90FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#DDDDDD" Text="CornerRadius" />
                            <Button Grid.Column="1" Margin="4,0,0,0"
                                    AutomationProperties.AutomationId="CornerRadiusExposurePin"
                                    Command="{Binding DataContext.TogglePropertyExposureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="CornerRadius"
                                    Style="{StaticResource ExposurePinButtonStyle}"
                                    ToolTip="このプロパティを公開する">
                                <TextBlock FontSize="11" Text="●">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#666666" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsCornerRadiusExposed.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                    <Setter Property="Foreground" Value="#1E90FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#DDDDDD" Text="RelativeX" />
                            <Button Grid.Column="1" Margin="4,0,0,0"
                                    AutomationProperties.AutomationId="RelativeXExposurePin"
                                    Command="{Binding DataContext.TogglePropertyExposureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="RelativeX"
                                    Style="{StaticResource ExposurePinButtonStyle}"
                                    ToolTip="このプロパティを公開する">
                                <TextBlock FontSize="11" Text="●">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#666666" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsRelativeXExposed.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                    <Setter Property="Foreground" Value="#1E90FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#DDDDDD" Text="RelativeY" />
                            <Button Grid.Column="1" Margin="4,0,0,0"
                                    AutomationProperties.AutomationId="RelativeYExposurePin"
                                    Command="{Binding DataContext.TogglePropertyExposureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="RelativeY"
                                    Style="{StaticResource ExposurePinButtonStyle}"
                                    ToolTip="このプロパティを公開する">
                                <TextBlock FontSize="11" Text="●">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#666666" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsRelativeYExposed.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                    <Setter Property="Foreground" Value="#1E90FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#DDDDDD" Text="IsNode" />
                            <Button Grid.Column="1" Margin="4,0,0,0"
                                    AutomationProperties.AutomationId="IsNodeExposurePin"
                                    Command="{Binding DataContext.TogglePropertyExposureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="IsNode"
                                    Style="{StaticResource ExposurePinButtonStyle}"
                                    ToolTip="このプロパティを公開する">
                                <TextBlock FontSize="11" Text="●">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#666666" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsIsNodeExposed.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                    <Setter Property="Foreground" Value="#1E90FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!--
                        Phase 4-g / Q-11 案 A: Phase 4 で追加された Glow 系公開可能プロパティ。
                        GlowRadius / GlowIntensity / GlowColor は SelectableDesignerItemViewModelBase
                        にあるので全派生で no-op ガード不要。値編集は inline では行わずピン留めのみ。
                    -->
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontWeight="Bold"
                            Foreground="#DDDDDD"
                            Text="Phase 4 公開可能プロパティ (グロー)" />
                        <ItemsControl AutomationProperties.AutomationId="Phase4ExposurePinList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#DDDDDD" Text="GlowRadius" />
                            <Button Grid.Column="1" Margin="4,0,0,0"
                                    AutomationProperties.AutomationId="GlowRadiusExposurePin"
                                    Command="{Binding DataContext.TogglePropertyExposureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="GlowRadius"
                                    Style="{StaticResource ExposurePinButtonStyle}"
                                    ToolTip="このプロパティを公開する">
                                <TextBlock FontSize="11" Text="●">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#666666" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsGlowRadiusExposed.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                    <Setter Property="Foreground" Value="#1E90FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#DDDDDD" Text="GlowIntensity" />
                            <Button Grid.Column="1" Margin="4,0,0,0"
                                    AutomationProperties.AutomationId="GlowIntensityExposurePin"
                                    Command="{Binding DataContext.TogglePropertyExposureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="GlowIntensity"
                                    Style="{StaticResource ExposurePinButtonStyle}"
                                    ToolTip="このプロパティを公開する">
                                <TextBlock FontSize="11" Text="●">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#666666" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsGlowIntensityExposed.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                    <Setter Property="Foreground" Value="#1E90FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#DDDDDD" Text="GlowColor" />
                            <Button Grid.Column="1" Margin="4,0,0,0"
                                    AutomationProperties.AutomationId="GlowColorExposurePin"
                                    Command="{Binding DataContext.TogglePropertyExposureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="GlowColor"
                                    Style="{StaticResource ExposurePinButtonStyle}"
                                    ToolTip="このプロパティを公開する">
                                <TextBlock FontSize="11" Text="●">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#666666" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsGlowColorExposed.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                    <Setter Property="Foreground" Value="#1E90FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!--
                        Phase 4-g-2: テーマ追従パーツ用のスロット名 / 線種名タグ。文字列ベースで公開。
                        パーツインスタンスごとに "primary" / "Dash" 等の値を持たせて、後段でテーマ追従できる。
                        動的バインドモード本体 (Q-3 案 B) は Phase 4.5 候補。
                    -->
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontWeight="Bold"
                            Foreground="#DDDDDD"
                            Text="Phase 4 公開可能プロパティ (テーマタグ)" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#DDDDDD" Text="PaletteSlotName" />
                            <Button Grid.Column="1" Margin="4,0,0,0"
                                    AutomationProperties.AutomationId="PaletteSlotNameExposurePin"
                                    Command="{Binding DataContext.TogglePropertyExposureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="PaletteSlotName"
                                    Style="{StaticResource ExposurePinButtonStyle}"
                                    ToolTip="このプロパティを公開する">
                                <TextBlock FontSize="11" Text="●">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#666666" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsPaletteSlotNameExposed.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                    <Setter Property="Foreground" Value="#1E90FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#DDDDDD" Text="LineStyleName" />
                            <Button Grid.Column="1" Margin="4,0,0,0"
                                    AutomationProperties.AutomationId="LineStyleNameExposurePin"
                                    Command="{Binding DataContext.TogglePropertyExposureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="LineStyleName"
                                    Style="{StaticResource ExposurePinButtonStyle}"
                                    ToolTip="このプロパティを公開する">
                                <TextBlock FontSize="11" Text="●">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#666666" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsLineStyleNameExposed.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                    <Setter Property="Foreground" Value="#1E90FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!--
                        Phase 1-c-6-d-6: 公開パラメータセクション。Definition.ExposedProperties を一覧表示し、
                        追加 / 削除できる。SelectedItem に依存せず常時表示。
                    -->
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="Bold"
                            Foreground="#DDDDDD"
                            Text="公開パラメータ" />

                        <ItemsControl
                            x:Name="ExposedPropertiesList"
                            AutomationProperties.AutomationId="ExposedPropertiesList"
                            ItemsSource="{Binding Definition.ExposedProperties}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,4"
                                        Padding="6,4"
                                        Background="#2D2D30"
                                        BorderBrush="#3F3F46"
                                        BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock
                                                    FontWeight="Bold"
                                                    Foreground="#DDDDDD"
                                                    Text="{Binding Name.Value}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="#AAAAAA">
                                                    <Run Text="{Binding Type.Value, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Width="22"
                                                Height="22"
                                                AutomationProperties.AutomationId="RemoveExposedPropertyButton"
                                                Command="{Binding DataContext.RemoveExposedPropertyCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Content="×"
                                                ToolTip="この公開パラメータを削除" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button
                            Margin="0,8,0,0"
                            Padding="6,4"
                            AutomationProperties.AutomationId="AddExposedPropertyButton"
                            Command="{Binding AddExposedPropertyCommand}"
                            Content="公開パラメータを追加…"
                            ToolTip="新しい公開パラメータを定義します" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  Editing canvas: shows PartDefinition.Items  -->
        <Grid Background="#1E1E1E">
            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsRoot" ItemsSource="{Binding Definition.Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas
                                MinWidth="400"
                                MinHeight="300"
                                Background="Transparent" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <!--
                            Border (Background=Transparent) で包んで hit-test を確保する。
                            内側の ContentPresenter は DataType マッチで既存の
                            <NRectangleViewModel> 用 DataTemplate (App.xaml) を使う。
                        -->
                        <DataTemplate>
                            <Border Background="Transparent">
                                <ContentPresenter Content="{Binding}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnItemPreviewMouseLeftButtonDown" />
                            <Setter Property="Canvas.Left" Value="{Binding Left.Value}" />
                            <Setter Property="Canvas.Top" Value="{Binding Top.Value}" />
                            <Setter Property="Panel.ZIndex" Value="{Binding ZIndex.Value}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected.Value}" Value="True">
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect
                                                BlurRadius="6"
                                                Color="#1E90FF"
                                                ShadowDepth="0" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
