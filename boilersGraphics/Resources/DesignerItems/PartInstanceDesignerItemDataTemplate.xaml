<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:parts="clr-namespace:boilersGraphics.ViewModels.Parts">
    <DataTemplate DataType="{x:Type parts:PartInstanceViewModel}">
        <DataTemplate.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </DataTemplate.Resources>
        <ContentControl Background="Transparent">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDoubleClick">
                    <i:InvokeCommandAction Command="{Binding MouseDoubleClickCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <Grid
                Width="{Binding Width.Value}"
                Height="{Binding Height.Value}"
                IsHitTestVisible="False">
                <Border
                    BorderBrush="#80808080"
                    BorderThickness="1"
                    Background="#10808080"
                    SnapsToDevicePixels="True" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="#A0808080"
                    Text="パーツ" />
                <!--
                    公開パラメータがある PartInstance に右上の小さな badge を重畳。
                    HasExposedParameters は instance.ParameterValues.Count > 0 のとき true。
                -->
                <Border
                    Margin="0,3,3,0"
                    Padding="3,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#FF1E90FF"
                    CornerRadius="2"
                    SnapsToDevicePixels="True"
                    ToolTip="公開パラメータあり"
                    Visibility="{Binding HasExposedParameters.Value, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        FontSize="9"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="公" />
                </Border>
            </Grid>
        </ContentControl>
    </DataTemplate>
</ResourceDictionary>
