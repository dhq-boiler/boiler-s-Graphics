<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:parts="clr-namespace:boilersGraphics.ViewModels.Parts">
    <DataTemplate DataType="{x:Type parts:PartInstanceViewModel}">
        <ContentControl Background="Transparent">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDoubleClick">
                    <i:InvokeCommandAction Command="{Binding MouseDoubleClickCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <Grid
                Width="{Binding Width.Value}"
                Height="{Binding Height.Value}"
                IsHitTestVisible="False">
                <Border
                    BorderBrush="#80808080"
                    BorderThickness="1"
                    Background="#10808080"
                    SnapsToDevicePixels="True" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="#A0808080"
                    Text="パーツ" />
            </Grid>
        </ContentControl>
    </DataTemplate>
</ResourceDictionary>
