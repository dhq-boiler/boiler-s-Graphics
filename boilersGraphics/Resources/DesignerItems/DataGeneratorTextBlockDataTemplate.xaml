<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:boilersGraphics.Converters"
    xmlns:text="clr-namespace:boilersGraphics.ViewModels.Text">
    <converters:BoolToTextWrappingConverter x:Key="BoolToTextWrappingConverter" />
    <DataTemplate DataType="{x:Type text:DataGeneratorTextBlockViewModel}">
        <Grid Width="{Binding Width.Value}" Height="{Binding Height.Value}">
            <Border Background="{Binding Background.Value}" />
            <TextBlock
                Padding="2"
                FontFamily="{Binding FontFamily.Value}"
                FontSize="{Binding FontSize.Value}"
                Foreground="{Binding Foreground.Value}"
                Opacity="{Binding TextOpacity.Value}"
                Text="{Binding Text.Value}"
                TextWrapping="{Binding IsWordWrap.Value, Converter={StaticResource BoolToTextWrappingConverter}}" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
